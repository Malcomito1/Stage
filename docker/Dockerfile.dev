# Development image for the Stage robot simulator.
#
# This image contains build/runtime DEPENDENCIES ONLY - never application code.
# The repository is bind-mounted at /src and compiled inside the container by
# docker/entrypoint.sh, so edits to the source are picked up on rebuild.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    libfltk1.3-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libgl1-mesa-dri \
    libpng-dev \
    libjpeg-dev \
    libltdl-dev \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    x11-utils \
    curl \
    procps \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# DISPLAY points at the Xvfb screen the FLTK GUI is rendered into.
# LD_LIBRARY_PATH + STAGEPATH point at the "make install" prefix the entrypoint
# builds into: libstage.so and the example controller plugins (e.g. wander.so)
# live in <prefix>/lib, and rgb.txt is found via STAGEPATH.
ENV DISPLAY=:1 \
    HOME=/root \
    LD_LIBRARY_PATH=/opt/stage/lib \
    STAGEPATH=/opt/stage/lib

WORKDIR /src
